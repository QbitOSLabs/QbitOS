# ═══════════════════════════════════════════════════════════════════════════════
# QbitOS Production Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to `.env` and adjust values for your deployment.
# All variables are optional — sensible defaults are built into the code.
#
# Status legend:
#   [wired]    — read by Rust source code at startup
#   [flag]     — sets the default for a CLI flag (override with --flag)
#   [auto]     — consumed automatically by a third-party crate
#   [planned]  — declared for forward compatibility; not yet consumed

# ─── Core ────────────────────────────────────────────────────────────────────

# [wired] Root data directory. Used by tools/, cli/persistence.rs, desktop/.
# Linux:   /var/lib/qbitos
# Windows: C:\ProgramData\QbitOS
# macOS:   ~/Library/Application Support/qbitos
QBITOS_DATA_DIR=/var/lib/qbitos

# [wired] Bearer token for HTTP auth. If set, all non-public routes require
# `Authorization: Bearer <token>`. If empty, auth is disabled.
QBITOS_TOKEN=

# [auto] Tracing filter (consumed by tracing_subscriber::EnvFilter).
# Examples: "info", "debug,qbitos=trace", "warn,sqlx=off"
RUST_LOG=info

# [wired] Log output format: "pretty" (default), "json", or "compact".
QBITOS_LOG_FORMAT=pretty

# ─── Memory Backends ─────────────────────────────────────────────────────────
# All backends are auto-attached at startup if their URL/path env var is set.
# At least one backend should be configured for production use.

# [wired] PostgreSQL with pgvector (DEFAULT primary backend).
DATABASE_URL=postgres://qbitos:password@localhost:5432/qbitos

# [wired] Qdrant vector database (high-scale ANN search).
QDRANT_URL=http://localhost:6333

# [wired] Redis (hot cache layer).
REDIS_URL=redis://localhost:6379

# [wired] MongoDB (document DB + Atlas Vector Search).
MONGODB_URL=mongodb://localhost:27017

# [wired] RocksDB (embedded / edge deployments — no separate server needed).
QBITOS_ROCKSDB_PATH=/var/lib/qbitos/rocksdb

# [wired] DuckDB (analytics / offline evaluation — embedded, file-based).
QBITOS_DUCKDB_PATH=/var/lib/qbitos/qbitos.duckdb

# ─── Neural Engine ───────────────────────────────────────────────────────────

# [wired] Directory for locally cached model weights.
QBITOS_MODEL_DIR=/var/lib/qbitos/models

# [wired] Hugging Face Hub cache directory (consumed by hf-hub crate).
HF_HOME=/var/lib/qbitos/hf-cache

# ─── Service Layer ───────────────────────────────────────────────────────────
# These are read by ServiceConfig::from_env() at startup.

# [flag] Bind address for the HTTP/WS/RPC server (override with --addr).
QBITOS_SERVE_ADDR=0.0.0.0:8080

# [flag] Human-readable instance name (override with --name).
QBITOS_INSTANCE_NAME=qbitos-prod

# [wired] Maximum concurrent HTTP requests before 503 backpressure.
QBITOS_MAX_CONCURRENT_REQUESTS=256

# [wired] Per-request timeout in milliseconds.
QBITOS_REQUEST_TIMEOUT_MS=30000

# [wired] Event bus channel capacity (in-flight events before backpressure).
QBITOS_EVENT_BUS_CAPACITY=4096

# [wired] Experience replay buffer capacity (training loop).
QBITOS_REPLAY_CAPACITY=10000

# [wired] Embedding dimension (must match vector(N) column in Postgres).
QBITOS_EMBEDDING_DIM=384

# ─── PostgreSQL Tuning ───────────────────────────────────────────────────────
# Read by PostgresConfig::default() at startup.

# [wired] HNSW ef_search parameter (controls recall vs speed at query time).
QBITOS_HNSW_EF_SEARCH=40

# [wired] Maximum connections in the Postgres connection pool.
QBITOS_PG_MAX_CONNECTIONS=16

# [wired] Connect timeout in seconds.
QBITOS_PG_CONNECT_TIMEOUT=10

# ─── Feature Flags ───────────────────────────────────────────────────────────

# [wired] Allow the self-improvement loop to mutate the skill registry.
# DANGEROUS in production — only enable in sandboxed dev environments.
QBITOS_ALLOW_SELF_IMPROVE=false

# [wired] Enforce safety filtering on all inputs (content moderation).
QBITOS_SAFETY_ENFORCED=true

# [wired] Record audit logs for all sensitive operations.
QBITOS_AUDIT_LOG=true

# [flag] Attach a persistent event store (events survive restarts).
# Override with --persistent-events on the `serve` subcommand.
QBITOS_PERSISTENT_EVENTS=false

# ─── Docker / Container ─────────────────────────────────────────────────────
# When running in Docker, set these in docker-compose.yml or `docker run -e`.
# The QBITOS_DATA_DIR should point to a mounted volume.
#
# Example docker-compose.yml snippet:
#   environment:
#     QBITOS_DATA_DIR: /var/lib/qbitos
#     DATABASE_URL: postgres://qbitos:qbitos_password@postgres:5432/qbitos
#     QDRANT_URL: http://qdrant:6333
#     REDIS_URL: redis://redis:6379
#     MONGODB_URL: mongodb://mongodb:27017
#     QBITOS_ROCKSDB_PATH: /var/lib/qbitos/rocksdb
#     QBITOS_DUCKDB_PATH: /var/lib/qbitos/qbitos.duckdb
#     RUST_LOG: info
#     QBITOS_LOG_FORMAT: json
#     QBITOS_TOKEN: ${QBITOS_TOKEN}

# ─── Windows Notes ───────────────────────────────────────────────────────────
# On Windows, use forward slashes or escaped backslashes in paths:
#   QBITOS_DATA_DIR=C:/ProgramData/QbitOS
#   QBITOS_ROCKSDB_PATH=C:/ProgramData/QbitOS/rocksdb
#   QBITOS_DUCKDB_PATH=C:/ProgramData/QbitOS/qbitos.duckdb
#   QBITOS_MODEL_DIR=C:/ProgramData/QbitOS/models
#   HF_HOME=C:/ProgramData/QbitOS/hf-cache
