[Unit]
Description=QbitOS Cognitive AI Operating System
Documentation=https://github.com/qbitos/qbitos
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=qbitos
Group=qbitos
WorkingDirectory=/opt/qbitos
EnvironmentFile=/etc/qbitos/qbitos.env
ExecStart=/usr/local/bin/qbitos serve --addr 0.0.0.0:8080 --name qbitos-prod --persistent-events --restricted-cors
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/qbitos
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
