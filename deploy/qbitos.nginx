# QbitOS Nginx Reverse Proxy Configuration
#
# Install:
#   sudo cp deploy/qbitos.nginx /etc/nginx/sites-available/qbitos
#   sudo ln -s /etc/nginx/sites-available/qbitos /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

upstream qbitos_backend {
    server 127.0.0.1:8080;
    keepalive 32;
}

# Rate limiting zone
limit_req_zone $binary_remote_addr zone=qbitos_api:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=qbitos_conn:10m;

server {
    listen 80;
    server_name qbitos.example.com;

    # Redirect to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name qbitos.example.com;

    # TLS certificates
    ssl_certificate     /etc/letsencrypt/live/qbitos.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/qbitos.example.com/privkey.pem;

    # TLS settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Security headers
    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    # Request size limit
    client_max_body_size 10m;

    # Rate limiting
    limit_req zone=qbitos_api burst=20 nodelay;
    limit_conn qbitos_conn 10;

    # API routes
    location /api/ {
        proxy_pass http://qbitos_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # WebSocket upgrade
    location /api/v1/events/ws {
        proxy_pass http://qbitos_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Health check (no rate limit)
    location /api/v1/health {
        proxy_pass http://qbitos_backend;
        access_log off;
    }
}
